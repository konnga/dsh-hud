{
  "name": "@konnga/dsh-hud",
  "version": "0.9.2",
  "description": "DeepSeek Harness 的只读工作区 Git 面板：分支、ahead/behind、改动清单与差异，外加「这个会话改过哪些文件、审到哪了、跑了什么工具」。A read-only workspace Git panel for DeepSeek Harness — branch, changed files, diffs, plus per-session change attribution, review progress, and tool activity.",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "main": "lib/host/index.js",
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs/images"
  ],
  "scripts": {
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.host.json --noEmit && node --test test/*.test.mjs",
    "build": "tsc -p tsconfig.host.json && rolldown -c rolldown.config.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.host.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.mjs\" \"scripts/**/*.mjs\" \"rolldown.config.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.mjs\" \"scripts/**/*.mjs\" \"rolldown.config.mjs\"",
    "tag": "node scripts/check-release.mjs --create",
    "prepublishOnly": "pnpm run build && pnpm test && node scripts/check-release.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "git",
    "hud",
    "session",
    "attribution",
    "review",
    "sidebar",
    "floating-panel",
    "web-gui",
    "deepseek",
    "diff",
    "image-diff",
    "session-timer",
    "prompt-history",
    "review-progress",
    "tool-activity",
    "dock"
  ],
  "license": "MIT",
  "author": "konnga",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konnga/dsh-hud.git"
  },
  "homepage": "https://github.com/konnga/dsh-hud#readme",
  "bugs": {
    "url": "https://github.com/konnga/dsh-hud/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-layout": "*",
    "@deepseek-ai/dsh-client-ui-renderer": "*",
    "@deepseek-ai/dsh-client-ui-session": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-layout": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-session": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "prettier": "^3.9.10",
    "rolldown": "^1.2.14",
    "typescript": "^7.0.2"
  }
}
